# Онлайн-матчи (Supabase Realtime). Без этих значений игра работает, но режим «Онлайн по ссылке» скрыт.
# Publishable (anon) key предназначен для кода в браузере — его можно публиковать.
# НИКОГДА не указывайте здесь secret / service_role key.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
